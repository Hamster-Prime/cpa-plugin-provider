+func authUsesPhysicalPath(auth *coreauth.Auth, path string) bool {
+	if auth == nil || strings.TrimSpace(path) == "" {
+		return false
+	}
+	for _, candidate := range []string{
+		authAttribute(auth, coreauth.AttributePath),
+		authAttribute(auth, coreauth.AttributeVirtualSource),
+		authAttribute(auth, coreauth.AttributeSource),
+	} {
+		if samePhysicalPath(candidate, path) {
+			return true
+		}
+	}
+	return false
+}
+
+func samePhysicalPath(left, right string) bool {
+	left = filepath.Clean(strings.TrimSpace(left))
+	right = filepath.Clean(strings.TrimSpace(right))
+	if left == "." || right == "." {
+		return false
+	}
+	if runtime.GOOS == "windows" {
+		return strings.EqualFold(left, right)
+	}
+	return left == right
+}
