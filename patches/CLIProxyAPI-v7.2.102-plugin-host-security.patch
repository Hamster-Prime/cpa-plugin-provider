+	}
+	client.Shutdown()
+
+	if _, exists := hostCallbackEntries.Load(id); exists {
+		t.Fatal("host callback registry entry remained after shutdown")
+	}
+	if client.handle != nil || client.hostAPI != nil || client.hostCtx != nil {
+		t.Fatalf("client native fields were not cleared: %#v", client)
+	}
+	if client.api.call != nil || client.api.free_buffer != nil || client.api.shutdown != nil {
+		t.Fatal("plugin function table remained callable after shutdown")
+	}
+
+	// Shutdown must stay idempotent after the retained native pointers have been
+	// detached from the Go client.
+	client.Shutdown()
+}
