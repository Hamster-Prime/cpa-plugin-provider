+func (h *Host) reconcileSavedAuths(ctx context.Context, path string, auths []*coreauth.Auth) error {
+	manager := h.currentAuthManager()
+	if manager == nil {
+		return nil
+	}
+	desired := make(map[string]struct{}, len(auths))
+	for _, auth := range auths {
+		desired[auth.ID] = struct{}{}
+		if errUpsert := h.upsertAuthRecord(ctx, auth); errUpsert != nil {
+			return errUpsert
+		}
+	}
+	for _, existing := range manager.List() {
+		if existing == nil || !authUsesPhysicalPath(existing, path) {
+			continue
