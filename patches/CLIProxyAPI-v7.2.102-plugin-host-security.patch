+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestHostHTTPClientDoesNotFollowCrossOriginRedirect(t *testing.T) {
+	for _, status := range []int{
+		http.StatusMovedPermanently,
+		http.StatusFound,
+		http.StatusSeeOther,
+		http.StatusTemporaryRedirect,
+		http.StatusPermanentRedirect,
+	} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			var redirectedRequests atomic.Int32
+			destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				redirectedRequests.Add(1)
+				if got := r.Header.Get("X-Api-Key"); got != "" {
+					t.Errorf("redirected X-Api-Key = %q, want empty", got)
+				}
+				if got := r.Header.Get("X-Goog-Api-Key"); got != "" {
+					t.Errorf("redirected X-Goog-Api-Key = %q, want empty", got)
+				}
+				if got := r.Header.Get("X-Provider-Secret"); got != "" {
+					t.Errorf("redirected X-Provider-Secret = %q, want empty", got)
+				}
+				w.WriteHeader(http.StatusNoContent)
+			}))
+			defer destination.Close()
+
+			source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if got := r.Header.Get("X-Api-Key"); got != "openai-secret" {
+					t.Errorf("source X-Api-Key = %q, want openai-secret", got)
+				}
+				if got := r.Header.Get("X-Goog-Api-Key"); got != "gemini-secret" {
+					t.Errorf("source X-Goog-Api-Key = %q, want gemini-secret", got)
+				}
+				if got := r.Header.Get("X-Provider-Secret"); got != "custom-secret" {
+					t.Errorf("source X-Provider-Secret = %q, want custom-secret", got)
+				}
+				http.Redirect(w, r, destination.URL+"/capture", status)
+			}))
+			defer source.Close()
+
+			resp, err := New().newHTTPClient(nil).Do(context.Background(), pluginapi.HTTPRequest{
+				Method: http.MethodPost,
+				URL:    source.URL + "/start",
+				Headers: http.Header{
+					"X-Api-Key":         []string{"openai-secret"},
+					"X-Goog-Api-Key":    []string{"gemini-secret"},
+					"X-Provider-Secret": []string{"custom-secret"},
+				},
+				Body: []byte(`{"request":true}`),
+			})
+			if err != nil {
+				t.Fatalf("Do() error = %v", err)
+			}
+			if resp.StatusCode != status {
+				t.Fatalf("status = %d, want %d", resp.StatusCode, status)
+			}
+			if got := resp.Headers.Get("Location"); got != destination.URL+"/capture" {
+				t.Fatalf("Location = %q, want %q", got, destination.URL+"/capture")
+			}
+			if got := redirectedRequests.Load(); got != 0 {
+				t.Fatalf("redirected requests = %d, want 0", got)
+			}
+		})
+	}
+}
+
+func TestSameHTTPOrigin(t *testing.T) {
+	tests := []struct {
+		name string
+		a    string
+		b    string
+		want bool
+	}{
+		{name: "same", a: "https://example.com/start", b: "https://example.com/next", want: true},
+		{name: "host case", a: "https://EXAMPLE.com/start", b: "https://example.com/next", want: true},
+		{name: "scheme", a: "http://example.com/start", b: "https://example.com/next", want: false},
+		{name: "port", a: "https://example.com:8443/start", b: "https://example.com/next", want: false},
+		{name: "explicit default port", a: "https://example.com:443/start", b: "https://example.com/next", want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			a, err := url.Parse(tt.a)
+			if err != nil {
+				t.Fatalf("parse a: %v", err)
+			}
+			b, err := url.Parse(tt.b)
+			if err != nil {
+				t.Fatalf("parse b: %v", err)
+			}
+			if got := sameHTTPOrigin(a, b); got != tt.want {
+				t.Fatalf("sameHTTPOrigin(%q, %q) = %v, want %v", tt.a, tt.b, got, tt.want)
+			}
+		})
+	}
+}
