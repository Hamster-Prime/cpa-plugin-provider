+func TestRPCExecutorCallbacksUseCallingHTTPClient(t *testing.T) {
+	for _, method := range []string{
+		pluginabi.MethodExecutorExecute,
+		pluginabi.MethodExecutorCountTokens,
+		pluginabi.MethodExecutorHTTPRequest,
+	} {
+		t.Run(method, func(t *testing.T) {
+			host := New()
+			boundClient := &callbackRecordingHTTPClient{}
+			pluginClient := &executorHTTPCallbackPluginClient{host: host}
+			adapter := &rpcPluginAdapter{id: "http-callback-plugin", host: host, client: pluginClient}
+
+			var body []byte
+			var err error
+			switch method {
+			case pluginabi.MethodExecutorExecute:
+				var response pluginapi.ExecutorResponse
+				response, err = adapter.Execute(context.Background(), pluginapi.ExecutorRequest{HTTPClient: boundClient})
+				body = response.Payload
+			case pluginabi.MethodExecutorCountTokens:
+				var response pluginapi.ExecutorResponse
+				response, err = adapter.CountTokens(context.Background(), pluginapi.ExecutorRequest{HTTPClient: boundClient})
+				body = response.Payload
+			case pluginabi.MethodExecutorHTTPRequest:
+				var response pluginapi.ExecutorHTTPResponse
+				response, err = adapter.HttpRequest(context.Background(), pluginapi.ExecutorHTTPRequest{HTTPClient: boundClient})
+				body = response.Body
+			}
+			if err != nil {
+				t.Fatalf("executor callback error = %v", err)
+			}
+			if got := string(body); got != "bound-client-response" {
+				t.Fatalf("response body = %q, want bound client response", got)
+			}
+			if got := boundClient.doCalls.Load(); got != 1 {
+				t.Fatalf("bound client Do calls = %d, want 1", got)
+			}
+			if got := boundClient.streamCalls.Load(); got != 0 {
+				t.Fatalf("bound client DoStream calls = %d, want 0", got)
+			}
+			if callbackContextExists(host, pluginClient.callbackID) {
+				t.Fatal("executor callback context remained open after call")
+			}
+		})
+	}
+}
