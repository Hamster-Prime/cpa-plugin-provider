+func TestExecutorAdapterTranslatesNativeTokenCountResponses(t *testing.T) {
+	tests := []struct {
+		name           string
+		upstreamFormat sdktranslator.Format
+		clientFormat   sdktranslator.Format
+		nativePayload  string
+		wantPayload    string
+	}{
+		{
+			name:           "openai upstream to claude",
+			upstreamFormat: sdktranslator.FormatOpenAI,
+			clientFormat:   sdktranslator.FormatClaude,
+			nativePayload:  `{"usage":{"prompt_tokens":11,"completion_tokens":0,"total_tokens":11}}`,
+			wantPayload:    `{"input_tokens":11}`,
+		},
+		{
+			name:           "gemini upstream to openai",
+			upstreamFormat: sdktranslator.FormatGemini,
+			clientFormat:   sdktranslator.FormatOpenAI,
+			nativePayload:  `{"totalTokens":12}`,
+			wantPayload:    `{"usage":{"prompt_tokens":12,"completion_tokens":0,"total_tokens":12}}`,
+		},
+		{
+			name:           "claude upstream to responses",
+			upstreamFormat: sdktranslator.FormatClaude,
+			clientFormat:   sdktranslator.FormatOpenAIResponse,
+			nativePayload:  `{"input_tokens":13}`,
+			wantPayload:    `{"usage":{"input_tokens":13,"output_tokens":0,"total_tokens":13}}`,
+		},
+		{
+			name:           "openai upstream to responses",
+			upstreamFormat: sdktranslator.FormatOpenAI,
+			clientFormat:   sdktranslator.FormatOpenAIResponse,
+			nativePayload:  `{"usage":{"prompt_tokens":15,"completion_tokens":0,"total_tokens":15}}`,
+			wantPayload:    `{"usage":{"input_tokens":15,"output_tokens":0,"total_tokens":15}}`,
+		},
+		{
+			name:           "openai upstream to gemini",
+			upstreamFormat: sdktranslator.FormatOpenAI,
+			clientFormat:   sdktranslator.FormatGemini,
+			nativePayload:  `{"usage":{"prompt_tokens":14,"completion_tokens":0,"total_tokens":14}}`,
+			wantPayload:    `{"totalTokens":14,"promptTokensDetails":[{"modality":"TEXT","tokenCount":14}]}`,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var captured pluginapi.ExecutorRequest
+			host := New()
+			adapter := newCurrentExecutorAdapterForTest(host, "token-count-executor", &fakeExecutor{
+				countTokens: func(ctx context.Context, req pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+					captured = req
+					return pluginapi.ExecutorResponse{
+						Payload:  []byte(test.nativePayload),
+						Headers:  http.Header{"X-Token-Count": []string{"yes"}},
+						Metadata: map[string]any{"native": test.upstreamFormat.String()},
+					}, nil
+				},
+			},
+				[]sdktranslator.Format{test.upstreamFormat},
+				[]sdktranslator.Format{test.upstreamFormat},
+			)
+
+			resp, errCount := adapter.CountTokens(context.Background(), &coreauth.Auth{}, coreexecutor.Request{
+				Model:   "model-1",
+				Format:  test.clientFormat,
+				Payload: executorTokenCountTestRequest(test.clientFormat),
+			}, coreexecutor.Options{
+				SourceFormat:   test.clientFormat,
+				ResponseFormat: test.clientFormat,
+			})
+			if errCount != nil {
+				t.Fatalf("CountTokens() error = %v", errCount)
+			}
+			if captured.Format != test.upstreamFormat.String() || captured.SourceFormat != test.upstreamFormat.String() {
+				t.Fatalf("executor formats = %q / %q, want %q", captured.SourceFormat, captured.Format, test.upstreamFormat)
+			}
+			if got := string(resp.Payload); got != test.wantPayload {
+				t.Fatalf("CountTokens() payload = %s, want %s", got, test.wantPayload)
+			}
+			if resp.Headers.Get("X-Token-Count") != "yes" || resp.Metadata["native"] != test.upstreamFormat.String() {
+				t.Fatalf("CountTokens() response metadata = %#v / %#v, want plugin values", resp.Headers, resp.Metadata)
+			}
+		})
+	}
+}
