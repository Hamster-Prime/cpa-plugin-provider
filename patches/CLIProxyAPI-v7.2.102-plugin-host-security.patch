+	doCalls     atomic.Int32
+	streamCalls atomic.Int32
+}
+
+type cancelAwareCallbackHTTPClient struct {
+	started chan struct{}
+}
+
+func (c *cancelAwareCallbackHTTPClient) Do(ctx context.Context, _ pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	close(c.started)
+	<-ctx.Done()
+	return pluginapi.HTTPResponse{}, ctx.Err()
+}
+
+func (c *cancelAwareCallbackHTTPClient) DoStream(context.Context, pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	return pluginapi.HTTPStreamResponse{}, fmt.Errorf("unexpected DoStream call")
+}
