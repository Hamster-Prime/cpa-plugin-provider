+func prepareSavedAuths(auths []*coreauth.Auth, pluginHandled bool, path string) ([]*coreauth.Auth, error) {
+	compact := make([]*coreauth.Auth, 0, len(auths))
+	for _, auth := range auths {
+		if auth != nil {
+			compact = append(compact, auth)
+		}
+	}
+	seen := make(map[string]struct{}, len(compact))
+	for index, auth := range compact {
+		auth.ID = strings.TrimSpace(auth.ID)
+		if auth.ID == "" {
+			return nil, fmt.Errorf("parsed auth at index %d has no id", index)
+		}
+		if _, exists := seen[auth.ID]; exists {
+			return nil, fmt.Errorf("parsed auth has duplicate id %q", auth.ID)
+		}
+		seen[auth.ID] = struct{}{}
+		if auth.Attributes == nil {
+			auth.Attributes = make(map[string]string)
+		}
+		auth.Attributes[coreauth.AttributePath] = path
+		auth.Attributes[coreauth.AttributeSource] = path
+		auth.Attributes[coreauth.AttributeSourceBackend] = coreauth.AuthSourceFile
+		if pluginHandled && len(compact) > 1 {
+			coreauth.MarkPluginVirtualAuth(auth, path, index)
+		}
