+func (a *executorAdapter) translateExecutorTokenCount(ctx context.Context, prepared preparedExecutorCall, payload []byte) ([]byte, error) {
+	if prepared.requestedFormat == "" || prepared.outputFormat == prepared.requestedFormat {
+		return bytes.Clone(payload), nil
+	}
+
+	if _, knownTarget := executorTokenCountPayload(prepared.requestedFormat, 0); !knownTarget {
+		return a.translateExecutorResponse(ctx, prepared, payload, false, nil), nil
+	}
+
+	nativeFormat := prepared.outputFormat
+	count, okCount := executorTokenCountValue(nativeFormat, payload)
+	if !okCount && prepared.inputFormat != nativeFormat {
+		if inputCount, okInputCount := executorTokenCountValue(prepared.inputFormat, payload); okInputCount {
+			count = inputCount
+			nativeFormat = prepared.inputFormat
+			okCount = true
+		}
+	}
+	if !okCount {
+		return nil, fmt.Errorf("plugin executor %s returned an invalid %s token count response", a.Identifier(), prepared.outputFormat)
+	}
+
+	fallback, _ := executorTokenCountPayload(prepared.requestedFormat, count)
+	return sdktranslator.TranslateTokenCount(ctx, nativeFormat, prepared.requestedFormat, count, fallback), nil
+}
+
+func executorTokenCountValue(format sdktranslator.Format, payload []byte) (int64, bool) {
+	if !gjson.ValidBytes(payload) {
+		return 0, false
+	}
+
+	var paths []string
+	switch normalizeExecutorFormatName(format.String()) {
+	case sdktranslator.FormatOpenAI:
+		paths = []string{"usage.prompt_tokens"}
+	case sdktranslator.FormatOpenAIResponse:
+		paths = []string{"usage.input_tokens", "response.usage.input_tokens"}
+	case sdktranslator.FormatClaude:
+		paths = []string{"input_tokens"}
+	case sdktranslator.FormatGemini:
+		paths = []string{"totalTokens", "usageMetadata.promptTokenCount"}
+	default:
+		return 0, false
+	}
+
+	for _, path := range paths {
+		value := gjson.GetBytes(payload, path)
+		if !value.Exists() || value.Type != gjson.Number {
+			continue
+		}
+		count := value.Int()
+		if count >= 0 {
+			return count, true
+		}
+	}
+	return 0, false
+}
+
+func executorTokenCountPayload(format sdktranslator.Format, count int64) ([]byte, bool) {
+	switch normalizeExecutorFormatName(format.String()) {
+	case sdktranslator.FormatOpenAI:
+		return []byte(fmt.Sprintf(`{"usage":{"prompt_tokens":%d,"completion_tokens":0,"total_tokens":%d}}`, count, count)), true
+	case sdktranslator.FormatOpenAIResponse:
+		return []byte(fmt.Sprintf(`{"usage":{"input_tokens":%d,"output_tokens":0,"total_tokens":%d}}`, count, count)), true
+	case sdktranslator.FormatClaude:
+		return []byte(fmt.Sprintf(`{"input_tokens":%d}`, count)), true
+	case sdktranslator.FormatGemini:
+		return []byte(fmt.Sprintf(`{"totalTokens":%d,"promptTokensDetails":[{"modality":"TEXT","tokenCount":%d}]}`, count, count)), true
+	default:
+		return nil, false
+	}
+}
