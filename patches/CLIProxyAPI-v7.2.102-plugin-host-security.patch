+
+type capturePluginApplier struct {
+	config ThinkingConfig
+}
+
+func (a *capturePluginApplier) Apply(body []byte, config ThinkingConfig, _ *registry.ModelInfo) ([]byte, error) {
+	a.config = config
+	var payload map[string]any
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return nil, err
+	}
+	payload["plugin_applied"] = true
+	return json.Marshal(payload)
+}
+
+func TestApplyThinkingWithApplierSeparatesWireFormatFromPluginProvider(t *testing.T) {
+	ClearPluginProviders()
+	t.Cleanup(ClearPluginProviders)
+	applier := &capturePluginApplier{}
+	if !RegisterPluginProvider("test-owner", "plugin-provider", 0, applier) {
+		t.Fatal("RegisterPluginProvider() = false")
+	}
+
+	out, err := ApplyThinkingWithApplier(
+		[]byte(`{"reasoning":{"effort":"high"}}`),
+		"custom-model",
+		"openai-response",
+		"openai-response",
+		"plugin-provider",
+		"plugin-provider",
+	)
+	if err != nil {
+		t.Fatalf("ApplyThinkingWithApplier() error = %v", err)
+	}
+	if applier.config.Mode != ModeLevel || applier.config.Level != LevelHigh {
+		t.Fatalf("captured config = %#v, want level/high", applier.config)
+	}
+	var payload map[string]any
+	if err = json.Unmarshal(out, &payload); err != nil || payload["plugin_applied"] != true {
+		t.Fatalf("output = %s, error = %v", out, err)
+	}
+}
+
+func TestApplyThinkingWithApplierValidatesConfiguredPluginModels(t *testing.T) {
+	ClearPluginProviders()
+	t.Cleanup(ClearPluginProviders)
+	applier := &capturePluginApplier{}
+	if !RegisterPluginProvider("test-owner", "plugin-provider", 0, applier) {
+		t.Fatal("RegisterPluginProvider() = false")
+	}
+
+	const clientID = "plugin-thinking-validation-test"
+	modelRegistry := registry.GetGlobalRegistry()
+	modelRegistry.RegisterClient(clientID, "plugin-provider", []*registry.ModelInfo{
+		{
+			ID:          "validated-levels",
+			Type:        "multi-protocol-provider",
+			UserDefined: false,
+			Thinking: &registry.ThinkingSupport{
+				Levels: []string{"low", "medium", "high"},
+			},
+		},
+		{
+			ID:          "validated-budget",
+			Type:        "multi-protocol-provider",
+			UserDefined: false,
+			Thinking: &registry.ThinkingSupport{
+				Min: 1024,
+				Max: 8192,
+			},
+		},
+	})
+	t.Cleanup(func() { modelRegistry.UnregisterClient(clientID) })
+
+	tests := []struct {
+		name       string
+		model      string
+		format     string
+		wantMode   ThinkingMode
+		wantBudget int
+		wantLevel  ThinkingLevel
+	}{
+		{name: "level maximum", model: "validated-levels(99999)", format: "openai", wantMode: ModeLevel, wantLevel: LevelHigh},
+		{name: "level cannot disable", model: "validated-levels(none)", format: "openai", wantMode: ModeNone, wantLevel: LevelLow},
+		{name: "level auto midpoint", model: "validated-levels(auto)", format: "openai", wantMode: ModeLevel, wantLevel: LevelMedium},
+		{name: "budget maximum", model: "validated-budget(99999)", format: "gemini", wantMode: ModeBudget, wantBudget: 8192},
+		{name: "budget cannot disable", model: "validated-budget(0)", format: "gemini", wantMode: ModeNone, wantBudget: 1024},
+		{name: "budget auto midpoint", model: "validated-budget(auto)", format: "gemini", wantMode: ModeBudget, wantBudget: 4608},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := ApplyThinkingWithApplier(
+				[]byte(`{}`),
+				tt.model,
+				tt.format,
+				tt.format,
+				"plugin-provider",
+				"plugin-provider",
+			)
+			if err != nil {
+				t.Fatalf("ApplyThinkingWithApplier() error = %v", err)
+			}
+			if applier.config.Mode != tt.wantMode || applier.config.Budget != tt.wantBudget || applier.config.Level != tt.wantLevel {
+				t.Fatalf("captured config = %#v, want mode=%s budget=%d level=%s", applier.config, tt.wantMode, tt.wantBudget, tt.wantLevel)
+			}
+		})
+	}
+}
