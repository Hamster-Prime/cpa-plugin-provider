+type streamCancelAwareCallbackHTTPClient struct {
+	canceled chan struct{}
+}
+
+type callbackClosingStreamHTTPClient struct {
+	closeCallback func()
+	canceled      chan struct{}
+}
+
+func (c *streamCancelAwareCallbackHTTPClient) Do(context.Context, pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	return pluginapi.HTTPResponse{}, fmt.Errorf("unexpected Do call")
+}
+
+func (c *streamCancelAwareCallbackHTTPClient) DoStream(ctx context.Context, _ pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	chunks := make(chan pluginapi.HTTPStreamChunk)
+	go func() {
+		<-ctx.Done()
+		close(c.canceled)
+		close(chunks)
+	}()
+	return pluginapi.HTTPStreamResponse{StatusCode: http.StatusOK, Chunks: chunks}, nil
+}
+
+func (c *callbackClosingStreamHTTPClient) Do(context.Context, pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	return pluginapi.HTTPResponse{}, fmt.Errorf("unexpected Do call")
+}
+
+func (c *callbackClosingStreamHTTPClient) DoStream(ctx context.Context, _ pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	c.closeCallback()
+	chunks := make(chan pluginapi.HTTPStreamChunk)
+	go func() {
+		<-ctx.Done()
+		close(c.canceled)
+		close(chunks)
+	}()
+	return pluginapi.HTTPStreamResponse{StatusCode: http.StatusOK, Chunks: chunks}, nil
+}
+
+func hostHTTPStreamExists(host *Host, streamID string) bool {
+	if host == nil || host.httpStreams == nil {
+		return false
+	}
+	host.httpStreams.mu.Lock()
+	_, exists := host.httpStreams.streams[streamID]
+	host.httpStreams.mu.Unlock()
+	return exists
+}
+
+func (c *callbackRecordingHTTPClient) Do(_ context.Context, req pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	if req.URL != callbackHTTPClientTestURL {
+		return pluginapi.HTTPResponse{}, fmt.Errorf("request URL = %q, want %q", req.URL, callbackHTTPClientTestURL)
+	}
+	c.doCalls.Add(1)
+	return pluginapi.HTTPResponse{
+		StatusCode: http.StatusCreated,
+		Headers:    http.Header{"X-Callback-Client": []string{"bound"}},
+		Body:       []byte("bound-client-response"),
+	}, nil
+}
+
+func (c *callbackRecordingHTTPClient) DoStream(_ context.Context, req pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	if req.URL != callbackHTTPClientTestURL {
+		return pluginapi.HTTPStreamResponse{}, fmt.Errorf("request URL = %q, want %q", req.URL, callbackHTTPClientTestURL)
+	}
+	c.streamCalls.Add(1)
+	chunks := make(chan pluginapi.HTTPStreamChunk, 1)
+	chunks <- pluginapi.HTTPStreamChunk{Payload: []byte("bound-client-stream")}
+	close(chunks)
+	return pluginapi.HTTPStreamResponse{
+		StatusCode: http.StatusPartialContent,
+		Headers:    http.Header{"X-Callback-Client": []string{"bound-stream"}},
+		Chunks:     chunks,
+	}, nil
+}
+
+type executorHTTPCallbackPluginClient struct {
+	host       *Host
+	callbackID string
+}
+
+func (c *executorHTTPCallbackPluginClient) Call(ctx context.Context, method string, request []byte) ([]byte, error) {
+	switch method {
+	case pluginabi.MethodExecutorExecute, pluginabi.MethodExecutorCountTokens:
+		var req rpcExecutorRequest
+		if err := json.Unmarshal(request, &req); err != nil {
+			return nil, fmt.Errorf("decode executor request: %w", err)
+		}
+		c.callbackID = req.HostCallbackID
+		response, err := c.callHostHTTPDo(ctx, req.HostCallbackID)
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(pluginapi.ExecutorResponse{Payload: response.Body, Headers: response.Headers})
+	case pluginabi.MethodExecutorHTTPRequest:
+		var req rpcExecutorHTTPRequest
+		if err := json.Unmarshal(request, &req); err != nil {
+			return nil, fmt.Errorf("decode executor HTTP request: %w", err)
+		}
+		c.callbackID = req.HostCallbackID
+		response, err := c.callHostHTTPDo(ctx, req.HostCallbackID)
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(pluginapi.ExecutorHTTPResponse{
+			StatusCode: response.StatusCode,
+			Headers:    response.Headers,
+			Body:       response.Body,
+		})
+	case pluginabi.MethodExecutorExecuteStream:
+		var req rpcExecutorRequest
+		if err := json.Unmarshal(request, &req); err != nil {
+			return nil, fmt.Errorf("decode executor stream request: %w", err)
+		}
+		c.callbackID = req.HostCallbackID
+		chunk, headers, err := c.callHostHTTPDoStream(ctx, req.HostCallbackID)
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(rpcExecutorStreamResponse{
+			Headers: headers,
+			Chunks:  []pluginapi.ExecutorStreamChunk{{Payload: chunk.Payload, Err: chunk.Err}},
+		})
+	default:
+		return nil, fmt.Errorf("unexpected plugin method %q", method)
+	}
+}
+
+func (c *executorHTTPCallbackPluginClient) Shutdown() {}
+
+func (c *executorHTTPCallbackPluginClient) callHostHTTPDo(ctx context.Context, callbackID string) (pluginapi.HTTPResponse, error) {
+	rawRequest, err := json.Marshal(rpcHostHTTPRequest{
+		HostCallbackID: callbackID,
+		Method:         http.MethodPost,
+		URL:            callbackHTTPClientTestURL,
+	})
+	if err != nil {
+		return pluginapi.HTTPResponse{}, err
+	}
+	callbackCtx := withHostCallbackPluginID(ctx, c.host.callbackContextPluginID(callbackID))
+	rawResponse, err := c.host.callFromPlugin(callbackCtx, pluginabi.MethodHostHTTPDo, rawRequest)
+	if err != nil {
+		return pluginapi.HTTPResponse{}, err
+	}
+	return decodeRPCEnvelope[pluginapi.HTTPResponse](rawResponse)
+}
+
+func (c *executorHTTPCallbackPluginClient) callHostHTTPDoStream(ctx context.Context, callbackID string) (pluginapi.HTTPStreamChunk, http.Header, error) {
+	rawRequest, err := json.Marshal(rpcHostHTTPRequest{
+		HostCallbackID: callbackID,
+		Method:         http.MethodPost,
+		URL:            callbackHTTPClientTestURL,
+	})
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	callbackCtx := withHostCallbackPluginID(ctx, c.host.callbackContextPluginID(callbackID))
+	rawResponse, err := c.host.callFromPlugin(callbackCtx, pluginabi.MethodHostHTTPDoStream, rawRequest)
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	response, err := decodeRPCEnvelope[rpcHostHTTPStreamResponse](rawResponse)
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	defer func() {
+		rawClose, _ := json.Marshal(rpcHostHTTPStreamCloseRequest{StreamID: response.StreamID})
+		_, _ = c.host.callFromPlugin(callbackCtx, pluginabi.MethodHostHTTPStreamClose, rawClose)
+	}()
+	rawRead, err := json.Marshal(rpcHostHTTPStreamReadRequest{StreamID: response.StreamID})
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	rawChunk, err := c.host.callFromPlugin(callbackCtx, pluginabi.MethodHostHTTPStreamRead, rawRead)
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	chunk, err := decodeRPCEnvelope[rpcHostHTTPStreamReadResponse](rawChunk)
+	if err != nil {
+		return pluginapi.HTTPStreamChunk{}, nil, err
+	}
+	if chunk.Done && len(chunk.Payload) == 0 {
+		return pluginapi.HTTPStreamChunk{}, nil, fmt.Errorf("host HTTP stream ended before yielding a chunk")
+	}
+	var chunkErr error
+	if chunk.Error != "" {
+		chunkErr = fmt.Errorf("%s", chunk.Error)
+	}
+	return pluginapi.HTTPStreamChunk{Payload: chunk.Payload, Err: chunkErr}, http.Header(response.Headers), nil
+}
